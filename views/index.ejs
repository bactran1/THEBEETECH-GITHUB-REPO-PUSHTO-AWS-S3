<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexusOmni Lab</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<style>
*, *::before, *::after {
  box-sizing: border-box;
}
html{
  scroll-behavior: smooth;
}
body {
  margin:0;
  font-family:Inter, sans-serif;
  background:#0a0a0a;
  color:#fff;
  margin: 0;
  padding-top: 64px; 
}

nav {
  position: fixed;
  top: 0;
  left: 0;              /* ✅ anchor left */
  right: 0;             /* ✅ anchor right */
  height: 64px;         /* ✅ consistent height */
  padding: 0 32px;
  background: rgba(10,10,10,0.7);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #222;
  display: flex;
  align-items: center;  /* ✅ vertical center */
  justify-content: space-between;
  z-index: 1000;        /* ✅ always on top */
  transition: background 0.3s ease, border 0.3s ease;
}

nav.scrolled {
  background: rgba(10,10,10,0.95);
  border-bottom: 1px solid #333;
}

nav a {
  color:#aaa;
  margin-left:16px;
  text-decoration:none;
  font-size: 0.9rem;
  transition: color 0.2s ease;
}

nav div {
  display: flex;
  align-items: center;
}

nav a:hover {
  color: #fff;
}

section {
  min-height:50vh;
  padding:120px 20px;
  text-align:center;
  max-width:900px;
  margin:auto;
}

h1 { font-size:clamp(2.5rem,5vw,3.5rem); }
h2 { font-size:clamp(1.8rem,4vw,2.2rem); }
p { color:#aaa; font-size:1.2rem; }

.accent { color:#ff6a00; }

.divider {
  height:1px;
  background:#222;
}

.fade {
  opacity:0;
  transform:translateY(40px);
}

.btn {
  display:inline-block;
  margin-top:20px;
  padding:12px 24px;
  background:#ff6a00;
  color:#fff;
  text-decoration:none;
  border-radius:6px;
}

canvas {
  width:100%;
  height:400px;
  margin-top:40px;
  background:#111;
  border-radius:12px;
}
</style>
</head>

<body>

<nav>
  <div>NexusOmni Lab</div>
  <div>
    <a href="#problem">Problem</a>
    <a href="#solution">Solution</a>
    <a href="#demo">Demo</a>
  </div>
</nav>

<section>
  <h1 class="fade">Rebuilding Material Handling<br><span class="accent">with Intelligence</span></h1>
  <p class="fade">We are not building a warehouse.<br>We are proving a new control paradigm.</p>
  <canvas id="canvas"></canvas>
</section>

<div class="divider"></div>

<section id="problem">
  <h2 class="fade">Material handling is still <span class="accent">rule-based</span></h2>
  <p class="fade">Rigid PLC systems. Hard-coded logic. No global optimization.</p>
</section>

<div class="divider"></div>

<section id="solution">
  <h2 class="fade">AI control layer for logistics</h2>
  <p class="fade">Simulation → Learning → Real-world deployment</p>
  <p class="fade">Powered by NVIDIA Omniverse</p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Why Us</h2>
  <p class="fade">We come from the MHE world. We understand real systems and its struggle.</p>
  <p class="fade"><span class="accent">This isn’t exploration. It’s execution.</span></p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Every conveyor becomes intelligent</h2>
  <p class="fade">Software-defined infrastructure. Continuous optimization.</p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Curious?</h2>
  <a href="mailto:bactran@bac-control.com" class="btn fade">Contact Us</a>
</section>

<script>
window.onload = function() {

  gsap.registerPlugin(ScrollTrigger);

  // Fade animations
  gsap.utils.toArray('.fade').forEach(el=>{
    gsap.to(el,{
      opacity:1,
      y:0,
      duration:1,
      scrollTrigger:{
        trigger:el,
        start:"top 85%"
      }
    });
  });

  // Conveyor animation
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = 400;
  }
  resize();
  window.addEventListener("resize", resize);

  let progress = 0;

  ScrollTrigger.create({
    trigger:"#demo",
    start:"top center",
    end:"bottom top",
    scrub:true,
    onUpdate:self => progress = self.progress
  });

  function draw() {
    ctx.clearRect(0,0,canvas.width,canvas.height);

    const w = canvas.width;
    const h = canvas.height;

    // main conveyor
    ctx.strokeStyle="#333";
    ctx.lineWidth=6;
    ctx.beginPath();
    ctx.moveTo(50,h/2);
    ctx.lineTo(w-50,h/2);
    ctx.stroke();

    // branch
    ctx.beginPath();
    ctx.moveTo(w*0.6,h/2);
    ctx.lineTo(w*0.8,h*0.7);
    ctx.stroke();

    // omniwheel rollers
    for(let x=60; x<w-60; x+=40){
      ctx.save();
      ctx.translate(x,h/2);
      ctx.rotate(Math.PI/4);
      ctx.fillStyle="#666";
      ctx.fillRect(-6,-2,12,4);
      ctx.restore();
    }

    // package movement
    let x = 50 + progress*(w-100);
    let y = h/2;

    if(progress > 0.6){
      let t = (progress-0.6)/0.4;
      x = w*0.6 + t*(w*0.2);
      y = h/2 + t*(h*0.2);
    }

    ctx.fillStyle="#ff6a00";
    ctx.shadowColor="#ff6a00";
    ctx.shadowBlur=20;
    ctx.fillRect(x-12,y-12,24,24);
    ctx.shadowBlur=0;

    requestAnimationFrame(draw);
  }

  draw();
};
</script>

</body>
</html>
