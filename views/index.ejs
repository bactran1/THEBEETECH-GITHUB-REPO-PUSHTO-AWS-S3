<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexusOmni Lab</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding-top: 64px;
  font-family: Inter, sans-serif;
  background: #0a0a0a;
  color: #fff;
  overflow-x: hidden;
}

/* TOP NAV */
nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 64px;
  padding: 0 24px;
  background: rgba(10,10,10,0.78);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #222;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1000;
}

.logo {
  font-weight: 600;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
}

.nav-links a {
  color: #aaa;
  text-decoration: none;
  font-size: 0.9rem;
}

.nav-links a:hover {
  color: #fff;
}

section {
  min-height: 100vh;
  padding: 100px 20px;
  text-align: center;
  max-width: 900px;
  margin: auto;
}

h1 {
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  line-height: 1.1;
}

h2 {
  font-size: clamp(1.8rem, 4vw, 2.4rem);
}

p {
  color: #aaa;
  font-size: 1.1rem;
  line-height: 1.6;
}

.accent {
  color: #ff6a00;
}

.divider {
  height: 1px;
  background: #222;
}

.fade {
  opacity: 0;
  transform: translateY(40px);
}

canvas {
  width: 100%;
  height: 400px;
  margin-top: 30px;
  background: #111;
  border-radius: 12px;
}


.solution-stage {
  margin-top: 34px;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
  gap: 22px;
  align-items: stretch;
}

#solutionCanvas {
  height: 430px;
  margin-top: 0;
  background: radial-gradient(circle at 50% 50%, #171717 0%, #0f0f0f 58%, #0a0a0a 100%);
  border: 1px solid #242424;
}

.solution-copy {
  display: grid;
  gap: 14px;
  text-align: left;
}

.solution-card {
  border: 1px solid #242424;
  background: rgba(255,255,255,0.035);
  border-radius: 14px;
  padding: 18px;
  opacity: 0.35;
  transform: translateY(12px);
  transition: opacity 0.12s linear, transform 0.12s linear, border-color 0.12s linear, background 0.12s linear;
}

.solution-card.active {
  opacity: 1;
  transform: translateY(0);
  border-color: rgba(255,106,0,0.72);
  background: rgba(255,106,0,0.10);
}

.solution-card h3 {
  margin: 0 0 6px;
  font-size: 1rem;
}

.solution-card p {
  margin: 0;
  font-size: 0.95rem;
}

video {
  width: 100%;
  max-width: 800px;
  margin-top: 30px;
  border-radius: 12px;
}

.btn {
  display: inline-block;
  margin-top: 20px;
  padding: 10px 20px;
  background: #ff6a00;
  color: #fff;
  text-decoration: none;
  border-radius: 6px;
}

/* MOBILE NAV */
@media (max-width: 600px) {
  nav {
    padding: 0 16px;
  }

  .nav-links {
    gap: 12px;
  }

  .nav-links a {
    font-size: 0.8rem;
  }

  .logo {
    font-size: 0.9rem;
  }

  .solution-stage {
    grid-template-columns: 1fr;
  }

  #solutionCanvas {
    height: 360px;
  }
}
</style>
</head>

<body>

<nav>
  <div class="logo">NexusOmni Lab</div>
  <div class="nav-links">
    <a href="#problem">Problem</a>
    <a href="#solution">Solution</a>
    <a href="#demo">Demo</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<section id="top">
  <h1 class="fade">Rebuilding Material Handling<br><span class="accent">with Intelligence</span></h1>
  <p class="fade">We are not building a warehouse.<br>We are proving a new control paradigm.</p>

  <canvas id="canvas"></canvas>
</section>

<div class="divider"></div>

<section id="problem">
  <h2 class="fade">Material handling is still <span class="accent">rule-based</span></h2>
  <p class="fade">Rigid PLC systems. Hard-coded logic.</p>
</section>

<div class="divider"></div>

<section id="solution">
  <h2 class="fade">AI control layer for logistics</h2>
  <p class="fade">Watch the control layer observe flow, decide a merge action, and send coordinated velocity commands.</p>

  <div class="solution-stage">
    <canvas id="solutionCanvas" aria-label="Scroll-controlled AI logistics control layer animation"></canvas>

    <div class="solution-copy">
      <div class="solution-card" data-step="0">
        <h3>1. Sense</h3>
        <p>Package position, conveyor occupancy, and merge-zone state are continuously observed.</p>
      </div>
      <div class="solution-card" data-step="1">
        <h3>2. Simulate</h3>
        <p>The digital twin predicts how flow will behave before the real system commits.</p>
      </div>
      <div class="solution-card" data-step="2">
        <h3>3. Decide</h3>
        <p>The AI policy chooses when to release, hold, accelerate, or slow each conveyor zone.</p>
      </div>
      <div class="solution-card" data-step="3">
        <h3>4. Control</h3>
        <p>Commands are pushed to the physical control layer while spacing and throughput stay stable.</p>
      </div>
    </div>
  </div>
</section>

<div class="divider"></div>

<section id="demo">
  <h2 class="fade">Real System Demo</h2>
  <p class="fade">Simulation to real-world</p>

  <video autoplay muted loop playsinline>
    <source src="/videos/FCTest1.mp4" type="video/mp4">
  </video>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Why Us</h2>
  <p class="fade">We come from the MHE world. We understand real systems.</p>
  <p class="fade"><span class="accent">This isn’t exploration. It’s execution.</span></p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Every conveyor becomes intelligent</h2>
  <p class="fade">Software-defined infrastructure. Continuous optimization.</p>
</section>

<div class="divider"></div>

<section id="contact">
  <h2 class="fade">Contact</h2>
  <a href="mailto:bactran@bac-control.com" class="btn fade">Send Inquiry</a>
</section>

<script>
window.onload = function() {
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll('nav a[href^="#"]').forEach(link => {

  link.addEventListener("click", function(e) {

    e.preventDefault();

    const target = document.querySelector(this.getAttribute("href"));

    if (!target) return;

    const navHeight = document.querySelector("nav").offsetHeight;

    const targetPosition = target.getBoundingClientRect().top + window.scrollY - navHeight;

    window.scrollTo({

      top: targetPosition,

      behavior: "smooth"

    });

  });

});
  // Fade text
  gsap.utils.toArray('.fade').forEach(el => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 1,
      scrollTrigger: {
        trigger: el,
        start: "top 85%"
      }
    });
  });

  // Canvas: package motion is 100% scroll-position driven.
  // There is no requestAnimationFrame loop, no timer, and no GSAP scrub smoothing.
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");
  let lastScrollProgress = 0;

  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = 400;
    draw(lastScrollProgress);
    ScrollTrigger.refresh();
  }

  window.addEventListener("resize", resize);

  function clamp(v, a, b) { return Math.min(Math.max(v, a), b); }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function smoothstep(t) { return t * t * (3 - 2 * t); }
  function segment(value, start, end) {
    return smoothstep(clamp((value - start) / (end - start), 0, 1));
  }

  function drawPackage(targetCtx, x, y, color, label) {
    targetCtx.save();
    targetCtx.fillStyle = color;
    targetCtx.shadowColor = color;
    targetCtx.shadowBlur = 15;
    targetCtx.fillRect(x - 13, y - 13, 26, 26);
    targetCtx.shadowBlur = 0;
    if (label) {
      targetCtx.fillStyle = "#fff";
      targetCtx.font = "600 11px Inter, sans-serif";
      targetCtx.textAlign = "center";
      targetCtx.textBaseline = "middle";
      targetCtx.fillText(label, x, y);
    }
    targetCtx.restore();
  }

  function draw(scrollProgress) {
    lastScrollProgress = clamp(scrollProgress, 0, 1);

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const w = canvas.width;
    const h = canvas.height;

    const mainStartX = 48;
    const mainEndX = w - 48;
    const mainY = h * 0.50;
    const mergeX = w * 0.64;
    const branchStartX = Math.max(70, mergeX - w * 0.34);
    const branchStartY = h * 0.80;
    const holdX = mergeX - 58;
    const holdY = mainY + 58;
    const convoyGap = 118;
    const leadAtMergeComplete = mergeX + convoyGap;
    const aStartX = -Math.max(520, w * 0.90);
    const exitLeadX = w + 150;

    // Conveyor lines
    ctx.strokeStyle = "#333";
    ctx.lineWidth = 7;
    ctx.lineCap = "round";

    // Main track
    ctx.beginPath();
    ctx.moveTo(mainStartX, mainY);
    ctx.lineTo(mainEndX, mainY);
    ctx.stroke();

    // Merge branch: diagonal branch makes it obvious that B enters from a different lane.
    ctx.beginPath();
    ctx.moveTo(branchStartX, branchStartY);
    ctx.lineTo(holdX, holdY);
    ctx.lineTo(mergeX, mainY);
    ctx.stroke();

    // Merge zone marker
    ctx.save();
    ctx.strokeStyle = "rgba(255,106,0,0.45)";
    ctx.lineWidth = 2;
    ctx.setLineDash([8, 8]);
    ctx.beginPath();
    ctx.arc(mergeX, mainY, 30, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();

    // Main omniwheel rollers
    for (let x = mainStartX + 12; x < mainEndX - 12; x += 40) {
      ctx.save();
      ctx.translate(x, mainY);
      ctx.rotate(Math.PI / 4);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    // Branch omniwheel rollers
    const branchRollers = 7;
    for (let i = 0; i <= branchRollers; i++) {
      const u = i / branchRollers;
      const bx = lerp(branchStartX, mergeX, u);
      const by = u < 0.72
        ? lerp(branchStartY, holdY, u / 0.72)
        : lerp(holdY, mainY, (u - 0.72) / 0.28);
      ctx.save();
      ctx.translate(bx, by);
      ctx.rotate(-Math.PI / 5);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    // Scroll-only timeline:
    // 0.00-0.30: B moves from branch start to a hold position.
    // 0.00-0.78: A travels from far off-screen left and clears the merge.
    // 0.30-0.68: B is parked and waiting.
    // 0.68-0.78: B merges after A is already ahead.
    // 0.78-1.00: A and B move right together with the same speed and fixed spacing.
    const s = lastScrollProgress;

    const aPreMerge = segment(s, 0.00, 0.78);
    const bApproach = segment(s, 0.00, 0.30);
    const bMerge = segment(s, 0.68, 0.78);
    const convoy = segment(s, 0.78, 1.00);

    let ax = lerp(aStartX, leadAtMergeComplete, aPreMerge);
    let ay = mainY;

    let bx = lerp(branchStartX, holdX, bApproach);
    let by = lerp(branchStartY, holdY, bApproach);

    // During the waiting window, B remains physically stopped at the branch hold point.
    if (s >= 0.30 && s < 0.68) {
      bx = holdX;
      by = holdY;
    }

    // Release B only after A has clearly passed the merge point.
    if (s >= 0.68 && s < 0.78) {
      bx = lerp(holdX, mergeX, bMerge);
      by = lerp(holdY, mainY, bMerge);
    }

    // After merge, both packages are locked to the same scroll-derived lead position.
    // This guarantees equal speed and a constant distance between them.
    if (s >= 0.78) {
      ax = lerp(leadAtMergeComplete, exitLeadX, convoy);
      bx = ax - convoyGap;
      by = mainY;
    }

    // Simple status text so the behavior is obvious during scrolling.
    ctx.save();
    ctx.fillStyle = "rgba(255,255,255,0.72)";
    ctx.font = "600 13px Inter, sans-serif";
    ctx.textAlign = "left";
    const status = s < 0.30 ? "B approaches hold point"
      : s < 0.68 ? "B waits while A passes"
      : s < 0.78 ? "B merges behind A"
      : "Both packages run right at matched speed";
    ctx.fillText(status, 24, 30);
    ctx.restore();

    drawPackage(ctx, ax, ay, "#ff6a00", "A");
    drawPackage(ctx, bx, by, "#00d4ff", "B");
  }

  resize();
  draw(0);


  // Solution section: also pure scroll input. No animation loop.
  const solutionCanvas = document.getElementById("solutionCanvas");
  const solutionCtx = solutionCanvas.getContext("2d");
  const solutionCards = gsap.utils.toArray(".solution-card");
  let lastSolutionProgress = 0;

  function resizeSolutionCanvas() {
    solutionCanvas.width = solutionCanvas.offsetWidth;
    solutionCanvas.height = solutionCanvas.offsetHeight || 430;
    drawSolution(lastSolutionProgress);
  }

  function roundedRect(ctx2, x, y, width, height, radius) {
    const r = Math.min(radius, width / 2, height / 2);
    ctx2.beginPath();
    ctx2.moveTo(x + r, y);
    ctx2.arcTo(x + width, y, x + width, y + height, r);
    ctx2.arcTo(x + width, y + height, x, y + height, r);
    ctx2.arcTo(x, y + height, x, y, r);
    ctx2.arcTo(x, y, x + width, y, r);
    ctx2.closePath();
  }

  function drawNode(ctx2, x, y, label, progressOn, accentColor) {
    const glow = clamp(progressOn, 0, 1);
    ctx2.save();
    ctx2.shadowColor = accentColor;
    ctx2.shadowBlur = 18 * glow;
    ctx2.fillStyle = `rgba(255,255,255,${0.05 + 0.07 * glow})`;
    ctx2.strokeStyle = `rgba(255,106,0,${0.25 + 0.55 * glow})`;
    ctx2.lineWidth = 2;
    roundedRect(ctx2, x - 58, y - 28, 116, 56, 14);
    ctx2.fill();
    ctx2.stroke();
    ctx2.shadowBlur = 0;
    ctx2.fillStyle = glow > 0.55 ? "#fff" : "#aaa";
    ctx2.font = "600 14px Inter, sans-serif";
    ctx2.textAlign = "center";
    ctx2.textBaseline = "middle";
    ctx2.fillText(label, x, y);
    ctx2.restore();
  }

  function drawArrow(ctx2, x1, y1, x2, y2, progressOn, color) {
    const p = clamp(progressOn, 0, 1);
    const xe = lerp(x1, x2, p);
    const ye = lerp(y1, y2, p);
    ctx2.save();
    ctx2.strokeStyle = color;
    ctx2.globalAlpha = 0.22 + 0.78 * p;
    ctx2.lineWidth = 3;
    ctx2.beginPath();
    ctx2.moveTo(x1, y1);
    ctx2.lineTo(xe, ye);
    ctx2.stroke();
    if (p > 0.96) {
      const angle = Math.atan2(y2 - y1, x2 - x1);
      ctx2.beginPath();
      ctx2.moveTo(x2, y2);
      ctx2.lineTo(x2 - 10 * Math.cos(angle - Math.PI / 6), y2 - 10 * Math.sin(angle - Math.PI / 6));
      ctx2.lineTo(x2 - 10 * Math.cos(angle + Math.PI / 6), y2 - 10 * Math.sin(angle + Math.PI / 6));
      ctx2.closePath();
      ctx2.fillStyle = color;
      ctx2.fill();
    }
    ctx2.restore();
  }

  function drawSolution(scrollProgress) {
    lastSolutionProgress = clamp(scrollProgress, 0, 1);
    const s = lastSolutionProgress;
    const ctx2 = solutionCtx;
    const w = solutionCanvas.width;
    const h = solutionCanvas.height;

    ctx2.clearRect(0, 0, w, h);

    const sourceX = w * 0.16;
    const twinX = w * 0.40;
    const aiX = w * 0.64;
    const controlX = w * 0.86;
    const y = h * 0.50;
    const trackY = h * 0.74;

    // Subtle grid
    ctx2.save();
    ctx2.strokeStyle = "rgba(255,255,255,0.045)";
    ctx2.lineWidth = 1;
    for (let gx = 30; gx < w; gx += 36) {
      ctx2.beginPath();
      ctx2.moveTo(gx, 26);
      ctx2.lineTo(gx, h - 26);
      ctx2.stroke();
    }
    for (let gy = 30; gy < h; gy += 36) {
      ctx2.beginPath();
      ctx2.moveTo(26, gy);
      ctx2.lineTo(w - 26, gy);
      ctx2.stroke();
    }
    ctx2.restore();

    // Physical conveyor at bottom
    ctx2.strokeStyle = "#333";
    ctx2.lineWidth = 7;
    ctx2.beginPath();
    ctx2.moveTo(50, trackY);
    ctx2.lineTo(w - 50, trackY);
    ctx2.stroke();

    for (let x = 62; x < w - 62; x += 38) {
      ctx2.save();
      ctx2.translate(x, trackY);
      ctx2.rotate(Math.PI / 4);
      ctx2.fillStyle = "#555";
      ctx2.fillRect(-6, -2, 12, 4);
      ctx2.restore();
    }

    const senseP = segment(s, 0.00, 0.23);
    const simP = segment(s, 0.20, 0.45);
    const decideP = segment(s, 0.42, 0.68);
    const controlP = segment(s, 0.65, 0.92);
    const deployP = segment(s, 0.82, 1.00);

    // Packages on the physical conveyor respond only near the end.
    const pkg1x = lerp(65, w - 160, deployP);
    const pkg2x = pkg1x - 78;
    drawPackage(ctx2, pkg1x, trackY, "#ff6a00", "A");
    drawPackage(ctx2, pkg2x, trackY, "#00d4ff", "B");

    // Sensor beams
    ctx2.save();
    ctx2.globalAlpha = 0.25 + 0.55 * senseP;
    ctx2.strokeStyle = "#00d4ff";
    ctx2.lineWidth = 2;
    for (let sx of [w * 0.24, w * 0.32]) {
      ctx2.beginPath();
      ctx2.moveTo(sx, trackY - 72);
      ctx2.lineTo(sx - 22, trackY - 6);
      ctx2.lineTo(sx + 22, trackY - 6);
      ctx2.closePath();
      ctx2.stroke();
    }
    ctx2.restore();

    drawNode(ctx2, sourceX, y, "Sensors", senseP, "#00d4ff");
    drawNode(ctx2, twinX, y, "Digital Twin", simP, "#ff6a00");
    drawNode(ctx2, aiX, y, "AI Policy", decideP, "#ff6a00");
    drawNode(ctx2, controlX, y, "Controls", controlP, "#00d4ff");

    drawArrow(ctx2, sourceX + 62, y, twinX - 66, y, senseP, "#00d4ff");
    drawArrow(ctx2, twinX + 62, y, aiX - 66, y, simP, "#ff6a00");
    drawArrow(ctx2, aiX + 62, y, controlX - 66, y, decideP, "#ff6a00");
    drawArrow(ctx2, controlX, y + 34, w * 0.72, trackY - 26, controlP, "#00d4ff");

    // AI decision pulse
    ctx2.save();
    ctx2.globalAlpha = decideP;
    ctx2.strokeStyle = "rgba(255,106,0,0.75)";
    ctx2.lineWidth = 2;
    ctx2.beginPath();
    ctx2.arc(aiX, y, 42 + 16 * decideP, 0, Math.PI * 2);
    ctx2.stroke();
    ctx2.restore();

    const activeStep = s < 0.25 ? 0 : s < 0.50 ? 1 : s < 0.75 ? 2 : 3;
    solutionCards.forEach((card, index) => {
      card.classList.toggle("active", index === activeStep);
    });
  }

  window.addEventListener("resize", resizeSolutionCanvas);
  resizeSolutionCanvas();

  ScrollTrigger.create({
    trigger: "#top",
    start: "top top",
    end: "+=1600",
    pin: true,
    scrub: false,
    invalidateOnRefresh: true,
    onUpdate: self => draw(self.progress),
    onRefresh: self => draw(self.progress)
  });

  ScrollTrigger.create({
    trigger: "#solution",
    start: "top top",
    end: "+=1700",
    pin: true,
    scrub: false,
    invalidateOnRefresh: true,
    onUpdate: self => drawSolution(self.progress),
    onRefresh: self => drawSolution(self.progress)
  });
};
</script>

</body>
</html>
