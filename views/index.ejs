<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexusOmni Lab</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding-top: 64px;
  font-family: Inter, sans-serif;
  background: #0a0a0a;
  color: #fff;
  overflow-x: hidden;
}

/* TOP NAV */
nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 64px;
  padding: 0 24px;
  background: rgba(10,10,10,0.78);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #222;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1000;
}

.logo {
  font-weight: 600;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
}

.nav-links a {
  color: #aaa;
  text-decoration: none;
  font-size: 0.9rem;
}

.nav-links a:hover {
  color: #fff;
}

section {
  min-height: 100vh;
  padding: 100px 20px;
  text-align: center;
  max-width: 900px;
  margin: auto;
}

h1 {
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  line-height: 1.1;
}

h2 {
  font-size: clamp(1.8rem, 4vw, 2.4rem);
}

p {
  color: #aaa;
  font-size: 1.1rem;
  line-height: 1.6;
}

.accent {
  color: #ff6a00;
}

.divider {
  height: 1px;
  background: #222;
}

.fade {
  opacity: 0;
  transform: translateY(40px);
}

canvas {
  width: 100%;
  height: 400px;
  margin-top: 30px;
  background: #111;
  border-radius: 12px;
}

video {
  width: 100%;
  max-width: 800px;
  margin-top: 30px;
  border-radius: 12px;
}

.btn {
  display: inline-block;
  margin-top: 20px;
  padding: 10px 20px;
  background: #ff6a00;
  color: #fff;
  text-decoration: none;
  border-radius: 6px;
}

/* MOBILE NAV */
@media (max-width: 600px) {
  nav {
    padding: 0 16px;
  }

  .nav-links {
    gap: 12px;
  }

  .nav-links a {
    font-size: 0.8rem;
  }

  .logo {
    font-size: 0.9rem;
  }
}
</style>
</head>

<body>

<nav>
  <div class="logo">NexusOmni Lab</div>
  <div class="nav-links">
    <a href="#problem">Problem</a>
    <a href="#solution">Solution</a>
    <a href="#demo">Demo</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<section id="top">
  <h1 class="fade">Rebuilding Material Handling<br><span class="accent">with Intelligence</span></h1>
  <p class="fade">We are not building a warehouse.<br>We are proving a new control paradigm.</p>

  <canvas id="canvas"></canvas>
</section>

<div class="divider"></div>

<section id="problem">
  <h2 class="fade">Material handling is still <span class="accent">rule-based</span></h2>
  <p class="fade">Rigid PLC systems. Hard-coded logic.</p>
</section>

<div class="divider"></div>

<section id="solution">
  <h2 class="fade">AI control layer for logistics</h2>
  <p class="fade">Simulation → Learning → Real-world deployment</p>
  <p class="fade">Powered by <span class="accent">NVIDIA Omniverse</span></p>
</section>

<div class="divider"></div>

<section id="demo">
  <h2 class="fade">Real System Demo</h2>
  <p class="fade">Simulation to real-world</p>

  <video autoplay muted loop playsinline>
    <source src="demo.mp4" type="video/mp4">
  </video>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Why Us</h2>
  <p class="fade">We come from the MHE world. We understand real systems.</p>
  <p class="fade"><span class="accent">This isn’t exploration. It’s execution.</span></p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Every conveyor becomes intelligent</h2>
  <p class="fade">Software-defined infrastructure. Continuous optimization.</p>
</section>

<div class="divider"></div>

<section id="contact">
  <h2 class="fade">Contact</h2>
  <a href="mailto:bactran@bac-control.com" class="btn fade">Send Inquiry</a>
</section>

<script>
window.onload = function() {
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll('nav a[href^="#"]').forEach(link => {

  link.addEventListener("click", function(e) {

    e.preventDefault();

    const target = document.querySelector(this.getAttribute("href"));

    if (!target) return;

    const navHeight = document.querySelector("nav").offsetHeight;

    const targetPosition = target.getBoundingClientRect().top + window.scrollY - navHeight;

    window.scrollTo({

      top: targetPosition,

      behavior: "smooth"

    });

  });

});
  // Fade text
  gsap.utils.toArray('.fade').forEach(el => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 1,
      scrollTrigger: {
        trigger: el,
        start: "top 85%"
      }
    });
  });

  // Canvas
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = 400;
  }

  resize();
  window.addEventListener("resize", resize);

  let progress = 0;

  ScrollTrigger.create({
    trigger: "#top",
    start: "top center",
    end: "bottom top",
    scrub: true,
    onUpdate: self => progress = self.progress
  });

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const w = canvas.width;
    const h = canvas.height;

    const mergeX = w * 0.65;
    const mainY = h / 2;
    const branchY = h * 0.75;

    // Conveyor lines
    ctx.strokeStyle = "#333";
    ctx.lineWidth = 6;

    ctx.beginPath();
    ctx.moveTo(50, mainY);
    ctx.lineTo(w - 50, mainY);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(mergeX, branchY);
    ctx.lineTo(mergeX, mainY);
    ctx.stroke();

    // Main omniwheel rollers
    for (let x = 60; x < w - 60; x += 40) {
      ctx.save();
      ctx.translate(x, mainY);
      ctx.rotate(Math.PI / 4);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    // Branch omniwheel rollers
    for (let y = branchY; y > mainY; y -= 30) {
      ctx.save();
      ctx.translate(mergeX, y);
      ctx.rotate(-Math.PI / 4);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    // Faster movement
    let eased = Math.pow(Math.min(progress * 1.8, 1), 1.4);

    // Package A
    let ax = 50 + eased * (mergeX - 100);
    let ay = mainY;

    // Package B
    let bx = mergeX;
    let by = branchY;

    // Conflict/yield timing
    const mergeStart = 0.48;
    const yieldStart = 0.52;
    const releaseStart = 0.68;
    // Move blue package up branch toward merge point

    if (progress < yieldStart) {
    let bt = progress / yieldStart;
    bt = Math.min(Math.max(bt, 0), 1);
    by = branchY - bt * (branchY - mainY - 30);
    }

    // Blue package yields just below the main conveyor
    else if (progress >= yieldStart && progress < releaseStart) {
    by = mainY + 30;
    }
    // Blue package merges onto main conveyor after orange clears
    else {
    let bt = (progress - releaseStart) / (1 - releaseStart);
    bt = Math.min(Math.max(bt, 0), 1);
    bx = mergeX + bt * (w * 0.35);
    by = mainY;
    }

    // Package A exits after merge
    if (progress > 0.62) {
    let at = (progress - 0.62) / 0.38;
    at = Math.min(Math.max(at, 0), 1);
    ax = mergeX + at * (w * 0.35);
    }

    // Draw package A
    ctx.fillStyle = "#ff6a00";
    ctx.shadowColor = "#ff6a00";
    ctx.shadowBlur = 15;
    ctx.fillRect(ax - 12, ay - 12, 24, 24);

    // Draw package B
    ctx.fillStyle = "#00d4ff";
    ctx.shadowColor = "#00d4ff";
    ctx.shadowBlur = 15;
    ctx.fillRect(bx - 12, by - 12, 24, 24);

    ctx.shadowBlur = 0;

    requestAnimationFrame(draw);
  }

  draw();
};
</script>

</body>
</html>
