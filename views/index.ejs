<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexusOmni Lab</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<style>
:root {
  --bg:#0a0a0a;
  --fg:#fff;
  --muted:#9a9a9a;
  --line:#1a1a1a;
  --accent:#ff6a00;
}

body {
  margin:0;
  font-family:'Inter',sans-serif;
  background:var(--bg);
  color:var(--fg);
  overflow-x:hidden;
}

nav {
  position:fixed;
  width:100%;
  top:0;
  padding:16px 24px;
  backdrop-filter:blur(12px);
  background:rgba(0,0,0,0.4);
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  z-index:10;
}

nav a { color:var(--muted); margin-left:16px; text-decoration:none; }
nav a:hover { color:#fff; }

section {
  min-height:100vh;
  padding:120px 24px;
  text-align:center;
  max-width:1000px;
  margin:auto;
}

h1 { font-size:clamp(2.5rem,6vw,4rem); }
h2 { font-size:clamp(1.8rem,4vw,2.5rem); }
p { color:var(--muted); font-size:1.2rem; }

.accent { color:var(--accent); }

.divider { height:1px; background:var(--line); }

.btn {
  display:inline-block;
  margin-top:30px;
  padding:14px 28px;
  background:var(--accent);
  color:#fff;
  border-radius:8px;
  text-decoration:none;
}

.fade {
  opacity:0;
  transform:translateY(40px);
}

/* Conveyor */
#conveyorCanvas {
  width:100%;
  height:500px;
  margin-top:40px;
  border-radius:12px;
  background:linear-gradient(#111,#0a0a0a);
}
</style>
</head>

<body>

<nav>
  <div>NexusOmni Lab</div>
  <div>
    <a href="#problem">Problem</a>
    <a href="#solution">Solution</a>
    <a href="#demo">Demo</a>
  </div>
</nav>

<section>
  <h1 class="fade">Rebuilding Material Handling<br><span class="accent">with Intelligence</span></h1>
  <p class="fade">We are not building a warehouse.<br>We are proving a new control paradigm.</p>
</section>

<div class="divider"></div>

<section id="problem">
  <h2 class="fade">Material handling is still <span class="accent">rule-based</span></h2>
  <p class="fade">Rigid PLC systems. Hard-coded logic. No global optimization.</p>
</section>

<div class="divider"></div>

<section id="solution">
  <h2 class="fade">AI control layer for logistics</h2>
  <p class="fade">Simulation → Learning → Real-world deployment</p>
  <p class="fade">Powered by :contentReference[oaicite:0]{index=0}</p>
</section>

<div class="divider"></div>

<section id="demo">
  <h2 class="fade">Autonomous Flow Control</h2>
  <p class="fade">Scroll to see intelligent routing in action</p>
  <canvas id="conveyorCanvas"></canvas>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Why Us</h2>
  <p class="fade">We come from the MHE world. We understand real systems.</p>
  <p class="fade"><span class="accent">This isn’t exploration. It’s execution.</span></p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Every conveyor becomes intelligent</h2>
  <p class="fade">Software-defined infrastructure. Continuous optimization.</p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Contact</h2>
  <a href="mailto:bactran@bac-control.com" class="btn fade">bactran@bac-control.com</a>
</section>

<script>
gsap.registerPlugin(ScrollTrigger);

// fade
gsap.utils.toArray('.fade').forEach(el=>{
  gsap.to(el,{
    opacity:1,
    y:0,
    duration:1,
    scrollTrigger:{trigger:el,start:"top 85%"}
  });
});

// Conveyor animation
const canvas=document.getElementById("conveyorCanvas");
const ctx=canvas.getContext("2d");

function resize(){
  canvas.width=canvas.clientWidth;
  canvas.height=500;
}
resize();
window.addEventListener("resize",resize);

let progress=0;

gsap.to({},{
  scrollTrigger:{
    trigger:"#demo",
    start:"top center",
    end:"bottom top",
    scrub:true
  },
  onUpdate:self=>progress=self.progress
});

function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);

  const w=canvas.width;
  const h=canvas.height;

  // conveyor line
  ctx.strokeStyle="#333";
  ctx.lineWidth=6;
  ctx.beginPath();
  ctx.moveTo(50,h/2);
  ctx.lineTo(w-50,h/2);
  ctx.stroke();

  // branch
  ctx.beginPath();
  ctx.moveTo(w*0.6,h/2);
  ctx.lineTo(w*0.8,h*0.75);
  ctx.stroke();

  // rollers
  for(let x=60;x<w-60;x+=30){
    ctx.beginPath();
    ctx.arc(x,h/2,5,0,Math.PI*2);
    ctx.fillStyle="#555";
    ctx.fill();
  }

  // package position
  let x=50+progress*(w-100);
  let y=h/2;

  if(progress>0.6){
    let t=(progress-0.6)/0.4;
    x=w*0.6+t*(w*0.2);
    y=h/2+t*(h*0.25);
  }

  // draw package
  ctx.fillStyle="#ff6a00";
  ctx.shadowColor="#ff6a00";
  ctx.shadowBlur=20;
  ctx.fillRect(x-10,y-10,20,20);
  ctx.shadowBlur=0;

  requestAnimationFrame(draw);
}
draw();
</script>

</body>
</html>
