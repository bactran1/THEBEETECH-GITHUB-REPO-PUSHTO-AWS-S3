<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexusOmni Lab</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding-top: 64px;
  font-family: Inter, sans-serif;
  background: #0a0a0a;
  color: #fff;
  overflow-x: hidden;
}

/* TOP NAV */
nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 64px;
  padding: 0 24px;
  background: rgba(10,10,10,0.78);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #222;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1000;
}

.logo {
  font-weight: 600;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
}

.nav-links a {
  color: #aaa;
  text-decoration: none;
  font-size: 0.9rem;
}

.nav-links a:hover {
  color: #fff;
}

section {
  min-height: 100vh;
  padding: 100px 20px;
  text-align: center;
  max-width: 900px;
  margin: auto;
}

h1 {
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  line-height: 1.1;
}

h2 {
  font-size: clamp(1.8rem, 4vw, 2.4rem);
}

p {
  color: #aaa;
  font-size: 1.1rem;
  line-height: 1.6;
}

.accent {
  color: #ff6a00;
}

.divider {
  height: 1px;
  background: #222;
}

.fade {
  opacity: 0;
  transform: translateY(40px);
}

canvas {
  width: 100%;
  height: 400px;
  margin-top: 30px;
  background: #111;
  border-radius: 12px;
}

video {
  width: 100%;
  max-width: 800px;
  margin-top: 30px;
  border-radius: 12px;
}

.btn {
  display: inline-block;
  margin-top: 20px;
  padding: 10px 20px;
  background: #ff6a00;
  color: #fff;
  text-decoration: none;
  border-radius: 6px;
}

/* MOBILE NAV */
@media (max-width: 600px) {
  nav {
    padding: 0 16px;
  }

  .nav-links {
    gap: 12px;
  }

  .nav-links a {
    font-size: 0.8rem;
  }

  .logo {
    font-size: 0.9rem;
  }
}
</style>
</head>

<body>

<nav>
  <div class="logo">NexusOmni Lab</div>
  <div class="nav-links">
    <a href="#problem">Problem</a>
    <a href="#solution">Solution</a>
    <a href="#demo">Demo</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<section id="top">
  <h1 class="fade">Rebuilding Material Handling<br><span class="accent">with Intelligence</span></h1>
  <p class="fade">We are not building a warehouse.<br>We are proving a new control paradigm.</p>

  <canvas id="canvas"></canvas>
</section>

<div class="divider"></div>

<section id="problem">
  <h2 class="fade">Material handling is still <span class="accent">rule-based</span></h2>
  <p class="fade">Rigid PLC systems. Hard-coded logic.</p>
</section>

<div class="divider"></div>

<section id="solution">
  <h2 class="fade">AI control layer for logistics</h2>
  <p class="fade">Simulation → Learning → Real-world deployment</p>
  <p class="fade">Powered by <span class="accent">NVIDIA Omniverse</span></p>
</section>

<div class="divider"></div>

<section id="demo">
  <h2 class="fade">Real System Demo</h2>
  <p class="fade">Simulation to real-world</p>

  <video autoplay muted loop playsinline>
    <source src="demo.mp4" type="video/mp4">
  </video>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Why Us</h2>
  <p class="fade">We come from the MHE world. We understand real systems.</p>
  <p class="fade"><span class="accent">This isn’t exploration. It’s execution.</span></p>
</section>

<div class="divider"></div>

<section>
  <h2 class="fade">Every conveyor becomes intelligent</h2>
  <p class="fade">Software-defined infrastructure. Continuous optimization.</p>
</section>

<div class="divider"></div>

<section id="contact">
  <h2 class="fade">Contact</h2>
  <a href="mailto:bactran@bac-control.com" class="btn fade">Send Inquiry</a>
</section>

<script>
window.onload = function() {
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll('nav a[href^="#"]').forEach(link => {

  link.addEventListener("click", function(e) {

    e.preventDefault();

    const target = document.querySelector(this.getAttribute("href"));

    if (!target) return;

    const navHeight = document.querySelector("nav").offsetHeight;

    const targetPosition = target.getBoundingClientRect().top + window.scrollY - navHeight;

    window.scrollTo({

      top: targetPosition,

      behavior: "smooth"

    });

  });

});
  // Fade text
  gsap.utils.toArray('.fade').forEach(el => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 1,
      scrollTrigger: {
        trigger: el,
        start: "top 85%"
      }
    });
  });

  // Canvas
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = 400;
  }

  resize();
  window.addEventListener("resize", resize);

  function clamp(v, a, b) { return Math.min(Math.max(v, a), b); }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function smoothstep(t) { return t * t * (3 - 2 * t); }
  function segment(value, start, end) {
    return smoothstep(clamp((value - start) / (end - start), 0, 1));
  }

  // Animation is now time-based instead of scroll-position based so the
  // start condition is always clear: A begins far to the left while B waits.
  const cycleMs = 9000;
  const holdMs = 900;
  const startedAt = performance.now();

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const w = canvas.width;
    const h = canvas.height;

    const mergeX = w * 0.68;
    const mainY = h / 2;
    const branchY = h * 0.76;
    const mainStartX = 42;
    const mainEndX = w - 42;

    // A starts very far left, outside the visible conveyor.
    const packageAStartX = -Math.max(360, w * 0.85);
    const packageExitX = w + 130;
    const convoyGap = Math.max(115, w * 0.16);
    const waitY = mainY + 44;

    // Conveyor lines
    ctx.strokeStyle = "#333";
    ctx.lineWidth = 6;

    ctx.beginPath();
    ctx.moveTo(mainStartX, mainY);
    ctx.lineTo(mainEndX, mainY);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(mergeX, branchY);
    ctx.lineTo(mergeX, mainY);
    ctx.stroke();

    // Main omniwheel rollers
    for (let x = mainStartX + 10; x < mainEndX - 10; x += 40) {
      ctx.save();
      ctx.translate(x, mainY);
      ctx.rotate(Math.PI / 4);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    // Branch omniwheel rollers
    for (let y = branchY; y > mainY; y -= 30) {
      ctx.save();
      ctx.translate(mergeX, y);
      ctx.rotate(-Math.PI / 4);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    const elapsed = (performance.now() - startedAt - holdMs) % cycleMs;
    const t = clamp(elapsed / cycleMs, 0, 1);

    // Package A timeline:
    // 0.00-0.48: comes from far off-screen left and passes the merge.
    // 0.48-1.00: continues right at the shared convoy speed.
    const aPassMerge = segment(t, 0.00, 0.48);
    const sharedRun = segment(t, 0.48, 1.00);
    let ax = lerp(packageAStartX, mergeX + convoyGap, aPassMerge);
    let ay = mainY;

    if (t > 0.48) {
      ax = lerp(mergeX + convoyGap, packageExitX, sharedRun);
    }

    // Package B timeline:
    // 0.00-0.30: moves up the branch only to a waiting position.
    // 0.30-0.55: waits while A clears the merge area.
    // 0.55-0.66: merges onto A's track.
    // 0.66-1.00: follows A at the same speed with the fixed convoy gap.
    const bMoveToWait = segment(t, 0.00, 0.30);
    const bMerge = segment(t, 0.55, 0.66);
    let bx = mergeX;
    let by = lerp(branchY, waitY, bMoveToWait);

    if (t > 0.55) {
      by = lerp(waitY, mainY, bMerge);
    }

    if (t > 0.66) {
      bx = ax - convoyGap;
      by = mainY;
    }

    // Waiting marker for B so the yield behavior is visually obvious.
    ctx.save();
    ctx.strokeStyle = "rgba(0, 212, 255, 0.45)";
    ctx.lineWidth = 2;
    ctx.setLineDash([5, 5]);
    ctx.beginPath();
    ctx.arc(mergeX, waitY, 20, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();

    // Draw package A
    ctx.fillStyle = "#ff6a00";
    ctx.shadowColor = "#ff6a00";
    ctx.shadowBlur = 15;
    ctx.fillRect(ax - 12, ay - 12, 24, 24);

    // Draw package B
    ctx.fillStyle = "#00d4ff";
    ctx.shadowColor = "#00d4ff";
    ctx.shadowBlur = 15;
    ctx.fillRect(bx - 12, by - 12, 24, 24);

    ctx.shadowBlur = 0;

    // Labels help make the distance relationship clear to non-technical viewers.
    ctx.font = "12px Inter, sans-serif";
    ctx.fillStyle = "rgba(255,255,255,0.75)";
    ctx.fillText("A", ax - 4, ay - 20);
    ctx.fillText("B waits", mergeX + 26, waitY + 4);

    requestAnimationFrame(draw);
  }

  draw();
};
</script>

</body>
</html>
