<section id="contact">
  <h2 class="fade">Contact</h2>
  <a href="mailto:bactran@bac-control.com" class="btn fade">Send Inquiry</a>
</section>

<script>
window.onload = function() {
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll('nav a[href^="#"]').forEach(link => {

  link.addEventListener("click", function(e) {

    e.preventDefault();

    const target = document.querySelector(this.getAttribute("href"));

    if (!target) return;

    const navHeight = document.querySelector("nav").offsetHeight;

    const targetPosition = target.getBoundingClientRect().top + window.scrollY - navHeight;

    window.scrollTo({

      top: targetPosition,

      behavior: "smooth"

    });

  });

});
  // Fade text
  gsap.utils.toArray('.fade').forEach(el => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 1,
      scrollTrigger: {
        trigger: el,
        start: "top 85%"
      }
    });
  });

  // Canvas
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = 400;
  }

  resize();
  window.addEventListener("resize", resize);

  function clamp(v, a, b) { return Math.min(Math.max(v, a), b); }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function smoothstep(t) { return t * t * (3 - 2 * t); }
  function segment(value, start, end) {
    return smoothstep(clamp((value - start) / (end - start), 0, 1));
  }

  // Animation is now time-based instead of scroll-position based so the
  // start condition is always clear: A begins far to the left while B waits.
  const cycleMs = 9000;
  const holdMs = 900;
  const startedAt = performance.now();

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const w = canvas.width;
    const h = canvas.height;

    const mergeX = w * 0.68;
    const mainY = h / 2;
    const branchY = h * 0.76;
    const mainStartX = 42;
    const mainEndX = w - 42;

    // A starts very far left, outside the visible conveyor.
    const packageAStartX = -Math.max(360, w * 0.85);
    const packageExitX = w + 130;
    const convoyGap = Math.max(115, w * 0.16);
    const waitY = mainY + 44;

    // Conveyor lines
    ctx.strokeStyle = "#333";
    ctx.lineWidth = 6;

    ctx.beginPath();
    ctx.moveTo(mainStartX, mainY);
    ctx.lineTo(mainEndX, mainY);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(mergeX, branchY);
    ctx.lineTo(mergeX, mainY);
    ctx.stroke();

    // Main omniwheel rollers
    for (let x = mainStartX + 10; x < mainEndX - 10; x += 40) {
      ctx.save();
      ctx.translate(x, mainY);
      ctx.rotate(Math.PI / 4);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    // Branch omniwheel rollers
    for (let y = branchY; y > mainY; y -= 30) {
      ctx.save();
      ctx.translate(mergeX, y);
      ctx.rotate(-Math.PI / 4);
      ctx.fillStyle = "#555";
      ctx.fillRect(-6, -2, 12, 4);
      ctx.restore();
    }

    const elapsed = (performance.now() - startedAt - holdMs) % cycleMs;
    const t = clamp(elapsed / cycleMs, 0, 1);

    // Package A timeline:
    // 0.00-0.48: comes from far off-screen left and passes the merge.
    // 0.48-1.00: continues right at the shared convoy speed.
    const aPassMerge = segment(t, 0.00, 0.48);
    const sharedRun = segment(t, 0.48, 1.00);
    let ax = lerp(packageAStartX, mergeX + convoyGap, aPassMerge);
    let ay = mainY;

    if (t > 0.48) {
      ax = lerp(mergeX + convoyGap, packageExitX, sharedRun);
    }

    // Package B timeline:
    // 0.00-0.30: moves up the branch only to a waiting position.
    // 0.30-0.55: waits while A clears the merge area.
    // 0.55-0.66: merges onto A's track.
    // 0.66-1.00: follows A at the same speed with the fixed convoy gap.
    const bMoveToWait = segment(t, 0.00, 0.30);
    const bMerge = segment(t, 0.55, 0.66);
    let bx = mergeX;
    let by = lerp(branchY, waitY, bMoveToWait);

    if (t > 0.55) {
      by = lerp(waitY, mainY, bMerge);
    }

    if (t > 0.66) {
      bx = ax - convoyGap;
      by = mainY;
    }

    // Waiting marker for B so the yield behavior is visually obvious.
    ctx.save();
    ctx.strokeStyle = "rgba(0, 212, 255, 0.45)";
    ctx.lineWidth = 2;
    ctx.setLineDash([5, 5]);
    ctx.beginPath();
    ctx.arc(mergeX, waitY, 20, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();

    // Draw package A
    ctx.fillStyle = "#ff6a00";
    ctx.shadowColor = "#ff6a00";
    ctx.shadowBlur = 15;
    ctx.fillRect(ax - 12, ay - 12, 24, 24);

    // Draw package B
    ctx.fillStyle = "#00d4ff";
    ctx.shadowColor = "#00d4ff";
    ctx.shadowBlur = 15;
    ctx.fillRect(bx - 12, by - 12, 24, 24);

    ctx.shadowBlur = 0;

    // Labels help make the distance relationship clear to non-technical viewers.
    ctx.font = "12px Inter, sans-serif";
    ctx.fillStyle = "rgba(255,255,255,0.75)";
    ctx.fillText("A", ax - 4, ay - 20);
    ctx.fillText("B waits", mergeX + 26, waitY + 4);

    requestAnimationFrame(draw);
  }

  draw();
};
</script>

</body>
